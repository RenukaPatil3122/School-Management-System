<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/et_syllabus_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_your_class"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="30dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/border"/>
    <Button
        android:id="@+id/btn_plygrp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Playgroup"
        android:textSize="16sp"/>
    <Button
        android:id="@+id/btn_nursury"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nursery"
        android:textSize="16sp"
        />

    <Button
        android:id="@+id/btn_jrkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="jrkg"
        android:textSize="16sp"/>

    <Button
        android:id="@+id/btn_srkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="srkg"
        android:textSize="16sp"
        />
    <Button
        android:id="@+id/btn_class1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Class 1"
        android:textSize="16sp"
        />
    <Button
        android:id="@+id/btn_class2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Class 2"
        android:textSize="16sp"
        />
    <Button
        android:id="@+id/btn_class3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Class 3"
        android:textSize="16sp"
        />
    <Button
        android:id="@+id/btn_class4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Class 4"
        android:textSize="16sp"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/studentImageView"
            android:layout_width="150dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:rotation="17"
            android:rotationY="-19"
            android:src="@drawable/img_1"
            android:layout_marginBottom="50dp"/>

        <ImageView
            android:id="@+id/schoolImageView"
            android:layout_width="200dp"
            android:layout_height="250dp"
            android:importantForAccessibility="no"
            android:src="@drawable/slogo"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true" />
    </RelativeLayout>


</LinearLayout>