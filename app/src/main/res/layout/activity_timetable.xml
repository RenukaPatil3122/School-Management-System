<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/labelTimetable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update timetable"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        />

    <ImageView
        android:id="@+id/imageViewTimetable"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:contentDescription="Timetable preview"
        android:scaleType="centerCrop"
        android:background="@android:color/darker_gray"/>

    <Button
        android:id="@+id/buttonSelectImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Image"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/buttonUploadTimetable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Upload/Update Timetable"
        android:layout_marginTop="16dp"/>
</LinearLayout>
